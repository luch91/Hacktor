{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hacktor-ingestion-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hacktor-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../database/migrations"
    }
  ],
  "vars": {
    "HACKTOR_ENV": "local",
    "CONNECTORS_ENABLED": "false"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "staging": {
      "name": "hacktor-ingestion-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hacktor-staging",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "../../database/migrations"
        }
      ],
      "vars": { "HACKTOR_ENV": "staging", "CONNECTORS_ENABLED": "false" }
    },
    "production": {
      "name": "hacktor-ingestion-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hacktor-production",
          "database_id": "22222222-2222-2222-2222-222222222222",
          "migrations_dir": "../../database/migrations"
        }
      ],
      "vars": { "HACKTOR_ENV": "production", "CONNECTORS_ENABLED": "false" }
    }
  }
}
